{
  "name": "@terminalogue/renderer",
  "version": "0.5.0",
  "description": "Shared DOM renderer and animation engine for Terminalogue. Host agnostic.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./terminalogue.css": "./dist/terminalogue.css"
  },
  "files": ["dist"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-css.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@terminalogue/core": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
