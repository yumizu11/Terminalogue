{
  "name": "terminalogue-vscode",
  "displayName": "Terminalogue",
  "description": "Turn `termlogue` Markdown code blocks into animated terminal sessions in the built-in Markdown preview.",
  "version": "0.5.0",
  "publisher": "yumizu",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#101218",
    "theme": "dark"
  },
  "homepage": "https://github.com/yumizu11/Terminalogue#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yumizu11/Terminalogue.git",
    "directory": "apps/vscode"
  },
  "bugs": {
    "url": "https://github.com/yumizu11/Terminalogue/issues"
  },
  "private": true,
  "type": "commonjs",
  "main": "./dist/extension.js",
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "terminal",
    "animation",
    "demo",
    "asciicast"
  ],
  "engines": {
    "vscode": "^1.86.0"
  },
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Terminalogue only renders text. It never executes the commands in a termlogue block."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./media/terminalogue-preview.js"
    ],
    "markdown.previewStyles": [
      "./media/terminalogue.css"
    ]
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ./scripts/build.mjs && node --test test/markdown-it-plugin.test.mjs test/preview-script.test.mjs"
  },
  "dependencies": {
    "@terminalogue/core": "workspace:*",
    "@terminalogue/renderer": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.86.0",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.1",
    "typescript": "~5.9.3",
    "jsdom": "^30.0.1"
  }
}
