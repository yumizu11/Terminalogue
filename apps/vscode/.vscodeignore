.vscode/**
src/**
test/**
scripts/**
node_modules/**
tsconfig.json
# Everything the build writes, except the one file the extension runs. Listing
# what may ship rather than what may not is what keeps a stray file — a scratch
# script, a second bundle built for the tests — out of the package.
dist/**
!dist/extension.js
**/*.map
**/*.ts
.vscodeignore
*.vsix
