{
  "name": "terminalogue-obsidian",
  "version": "0.5.0",
  "description": "Obsidian plugin rendering termlogue code blocks as animated terminal sessions.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "clean": "node -e \"fs.rmSync('main.js',{force:true});fs.rmSync('main.js.map',{force:true});fs.rmSync('styles.css',{force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ./scripts/build.mjs && node --test test/bundle.test.mjs",
    "deploy": "node ./scripts/deploy.mjs"
  },
  "dependencies": {
    "@terminalogue/core": "workspace:*",
    "@terminalogue/renderer": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "~5.9.3",
    "jsdom": "^30.0.1"
  }
}
