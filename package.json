{
  "name": "terminalogue",
  "version": "0.6.0",
  "private": true,
  "description": "Turn Markdown code blocks into animated terminal sessions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r run build && node ./scripts/stage-obsidian-plugin.mjs",
    "clean": "pnpm -r run clean && node -e \"for (const f of ['main.js','styles.css']) fs.rmSync(f,{force:true})\"",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "lint:obsidian": "eslint -c eslint.obsidian.config.mjs .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test",
    "release:obsidian": "node ./scripts/release-obsidian.mjs",
    "release:obsidian:sync": "node ./scripts/release-obsidian.mjs --sync"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "^17.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
