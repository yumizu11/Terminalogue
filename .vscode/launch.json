{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Terminalogue VS Code extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode",
        "${workspaceFolder}/examples/nginx.md",
        "${workspaceFolder}/examples/themes.md"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.js"]
    }
  ]
}
